//@version=5
indicator("AMD + Liquidity Sweep + FVG (Photo Inspired)", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// =====================
// Inputs
// =====================
rangeLen         = input.int(40, "Accumulation lookback", minval=10)
sweepLookback    = input.int(20, "Swing high/low lookback", minval=5)
atrLen           = input.int(14, "ATR Length", minval=1)
manipAtrMult     = input.float(1.2, "Manipulation impulse ATR x", step=0.1)
showFVG          = input.bool(true, "Afficher FVG")
showIFVG         = input.bool(true, "Afficher IFVG")
extendBars       = input.int(40, "Extension zones (barres)", minval=5)

colAccum         = color.new(color.gray, 87)
colManip         = color.new(color.blue, 85)
colDistrib       = color.new(color.teal, 85)
colFVGup         = color.new(color.orange, 82)
colFVGdown       = color.new(color.aqua, 82)

atr = ta.atr(atrLen)

// =====================
// 1) Accumulation zone
// =====================
accHigh = ta.highest(high, rangeLen)
accLow  = ta.lowest(low, rangeLen)

var box accBox = na
if barstate.islast
    if not na(accBox)
        box.delete(accBox)
    accBox := box.new(left=bar_index - rangeLen, top=accHigh, right=bar_index, bottom=accLow, bgcolor=colAccum, border_color=color.new(color.gray, 30))

// Buy-side / Sell-side liquidity lines from range
buyLiq = accHigh
sellLiq = accLow
plot(buyLiq, "Buy Side Liquidity", color=color.new(color.red, 0), linewidth=2)
plot(sellLiq, "Sell Side Liquidity", color=color.new(color.black, 0), linewidth=2)

// =====================
// 2) Manipulation logic
// Sweep above previous swing high + rejection + impulse
// =====================
prevSwingHigh = ta.highest(high[1], sweepLookback)
prevSwingLow  = ta.lowest(low[1], sweepLookback)

sweepUp = high > prevSwingHigh and close < prevSwingHigh
sweepDn = low < prevSwingLow and close > prevSwingLow

bearImpulse = (high - low) > atr * manipAtrMult and close < open
bullImpulse = (high - low) > atr * manipAtrMult and close > open

manipShort = sweepUp and bearImpulse
manipLong  = sweepDn and bullImpulse

plotshape(manipShort, title="Manipulation Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="M")
plotshape(manipLong,  title="Manipulation Long",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small, text="M")

// Highlight manipulation candles
bgcolor(manipShort or manipLong ? colManip : na)

// =====================
// 3) FVG detection (3-candle model)
// Bull FVG: low > high[2]
// Bear FVG: high < low[2]
// =====================
bullFVG = low > high[2]
bearFVG = high < low[2]

var box[] fvgBoxes = array.new_box()

if showFVG and bullFVG
    b = box.new(bar_index-2, low, bar_index + extendBars, high[2], bgcolor=colFVGup, border_color=color.new(color.orange, 25))
    array.push(fvgBoxes, b)

if showFVG and bearFVG
    b = box.new(bar_index-2, low[2], bar_index + extendBars, high, bgcolor=colFVGdown, border_color=color.new(color.aqua, 25))
    array.push(fvgBoxes, b)

// =====================
// 4) IFVG (inversion) idea
// If price closes through opposite edge, mark inversion
// =====================
if showIFVG and array.size(fvgBoxes) > 0
    for i = 0 to array.size(fvgBoxes)-1
        bb = array.get(fvgBoxes, i)
        top = box.get_top(bb)
        bot = box.get_bottom(bb)

        // Invalidation / inversion markers
        invBear = close < bot
        invBull = close > top

        if invBear
            label.new(bar_index, bot, "IFVG ↓", style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.tiny)
        if invBull
            label.new(bar_index, top, "IFVG ↑", style=label.style_label_up, textcolor=color.white, color=color.new(color.green, 0), size=size.tiny)

// =====================
// 5) Distribution context
// After manipulation short, paint future bars area as distribution bias
// =====================
var int distStart = na
if manipShort
    distStart := bar_index

var box distBox = na
if not na(distStart) and bar_index > distStart
    if not na(distBox)
        box.delete(distBox)
    distTop = ta.highest(high, math.min(bar_index - distStart + 1, 100))
    distBot = ta.lowest(low, math.min(bar_index - distStart + 1, 100))
    distBox := box.new(distStart, distTop, bar_index, distBot, bgcolor=colDistrib, border_color=color.new(color.teal, 55))

// =====================
// Alerts
// =====================
alertcondition(manipShort, "Manipulation Short", "Sweep buy-side + bearish impulse détecté")
alertcondition(manipLong,  "Manipulation Long",  "Sweep sell-side + bullish impulse détecté")
alertcondition(bullFVG,    "Bullish FVG",        "Bullish FVG détecté")
alertcondition(bearFVG,    "Bearish FVG",        "Bearish FVG détecté")
